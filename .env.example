# Provod.ai API key (server only — never expose to the browser)
# https://provod.ai/ru/docs/authentication
PROVOD_API_KEY=

# Preferred model. If locked until first top-up, server falls back to PROVOD_FALLBACK_MODEL.
PROVOD_MODEL=gemini-2.5-flash
PROVOD_FALLBACK_MODEL=gemini-3.1-flash-lite

# Server port (default: 3001)
PORT=3001
